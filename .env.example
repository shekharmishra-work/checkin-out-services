APP_NAME=fastapi-cloud-run-template
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0
SLOW_REQUEST_MS=1000

# Optional. In Cloud Run, platform-infra should inject these from Secret Manager.
# Use the values from Grafana's OpenTelemetry connection tile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
