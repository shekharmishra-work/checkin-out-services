# Google AI Studio API key — get yours at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_key_here

APP_NAME=checkin-out-service
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0
SLOW_REQUEST_MS=1000

# Optional. In Cloud Run, platform-infra should inject these from Secret Manager.
# Use the values from Grafana's OpenTelemetry connection tile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Google Sheets Configuration
GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account-key.json
GOOGLE_SHEETS_SPREADSHEET_ID=1GSoCeDO3stPvl3N3Pr1jgnN-ISjZc8TSqUfx1Mciuzc

# BigQuery & GCS Configuration (Optional)
GCP_PROJECT_ID=drivers-klub
BQ_DATASET_ID=AI_checkin_out
GCS_BUCKET_NAME=
